# AlertHub — environment variables
# Copy to .env.local for local dev (never commit .env.local — it is gitignored).
# PLACEHOLDER VALUES ONLY. Generate real values as described in README.md.
# Never paste a real key into this file or into git.

# --- Storage: Vercel KV / Upstash Redis (linked store injects these) --------
# Provisioned via Vercel Dashboard → Storage → Create → Upstash Redis
# (or Vercel KV) → connect to this project → redeploy. Until then the API
# answers 503 for writes and GET /api/alerts falls back to seed data.
KV_REST_API_URL=https://your-store-xxxx.upstash.io
KV_REST_API_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Ingest: shared secret for POST /api/v1/events --------------------------
# Generate with: openssl rand -hex 32
# Muse's scheduled Gmail/CUIMS checks use this key to forward new alerts.
INGEST_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Web Push (VAPID) ------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: address or https: URL you control.
VAPID_PUBLIC_KEY=CHANGE_ME_generate_with_npx_web_push_generate_vapid_keys
VAPID_PRIVATE_KEY=CHANGE_ME_generate_with_npx_web_push_generate_vapid_keys
VAPID_SUBJECT=mailto:itsmanan.dev@gmail.com

# --- Frontend (build-time) -------------------------------------------------
# Same value as VAPID_PUBLIC_KEY. Vite inlines VITE_* vars into the client
# bundle at build time, so this must be set in Vercel before deploying.
VITE_VAPID_PUBLIC_KEY=CHANGE_ME_same_value_as_VAPID_PUBLIC_KEY
